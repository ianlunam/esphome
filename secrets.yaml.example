wifi_ssid: "YourWifiSSID"
wifi_password: "YourWifiPassword"
# Generate your own: `openssl rand -base64 32`
api_encryption_key: "REPLACE_WITH_YOUR_OWN_GENERATED_KEY"
# From Home Assistant: Settings -> Devices & services -> Thread -> (network)
# -> ... -> Show credentials -> "Operational Dataset TLVs"
thread_operational_dataset_tlv: "REPLACE_WITH_YOUR_THREAD_DATASET_TLV_HEX"
