wifi_ssid: "YourWifiSSID"
wifi_password: "YourWifiPassword"
# Generate your own: `openssl rand -base64 32`
api_encryption_key: "REPLACE_WITH_YOUR_OWN_GENERATED_KEY"
# From Home Assistant: Settings -> Devices & services -> Thread -> (network)
# -> ... -> Show credentials -> "Operational Dataset TLVs"
thread_operational_dataset_tlv: "REPLACE_WITH_YOUR_THREAD_DATASET_TLV_HEX"

# Lounge controller (lounge-controller.yaml): its own key, per the Setup notes
lounge_controller_api_key: "REPLACE_WITH_YOUR_OWN_GENERATED_KEY"

# Alarm clock (alarm-clock.yaml): its own key, per the Setup notes
alarm_clock_api_key: "REPLACE_WITH_YOUR_OWN_GENERATED_KEY"

# Hot water dial (hot-water-dial.yaml): its own key, per the Setup notes
hot_water_dial_api_key: "REPLACE_WITH_YOUR_OWN_GENERATED_KEY"
